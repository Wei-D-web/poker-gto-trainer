# ==========================================
# J.A.R.V.I.S. Platform — Environment Variables
# ==========================================
# Copy this to backend/.env and fill in your values.
# The backend loads .env from its working directory.

# ── App ──
APP_NAME=J.A.R.V.I.S.
DEBUG=true
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173","http://localhost:3000"]

# ── Server ──
HOST=0.0.0.0
PORT=8765

# ── LLM APIs (at least one required) ──
# DeepSeek (primary, OpenAI-compatible)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic (Claude Vision, Sonnet, Opus)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT-4V, fallback)
OPENAI_API_KEY=sk-...

# ── LLM Router ──
DEFAULT_MODEL=deepseek-chat
VISION_MODEL=claude-sonnet-5
FAST_MODEL=deepseek-chat

# ── Speech ──
WHISPER_MODEL=base          # tiny / base / small / medium / large-v3
WHISPER_DEVICE=cpu          # cpu / cuda / mps
TTS_VOICE=Daniel            # macOS: Daniel (UK), Samantha (US), Alex (US)

# ── Vision ──
VISION_PROVIDER=anthropic   # anthropic or openai

# ── Research ──
SERPAPI_KEY=                # Optional, for Google Search results
# DUCKDUCKGO_ENABLED=true   # Always enabled

# ── Agent Swarm ──
MAX_PARALLEL_AGENTS=5
AGENT_TIMEOUT_SECONDS=120

# ── Memory ──
CHROMA_PERSIST_DIR=./data/chroma

# ── Proactive ──
ENABLE_PROACTIVE=false
CHECK_INTERVAL_SECONDS=300
